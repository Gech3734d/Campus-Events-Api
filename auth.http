### TEST API
GET {{baseUrl}}/events

### REGISTER: New customer
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "newcustomer@example.et",
  "password": "Password123!"
}

### LOGIN: Wrong password
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "almaz@example.et",
  "password": "WrongPassword123!"
}

### GET: Current user
GET {{baseUrl}}/auth/me
Authorization: Bearer {{accessToken}}
@adminToken = PASTE_ADMIN_ACCESS_TOKEN
@organizer10Token = PASTE_USER10_ACCESS_TOKEN
@organizer20Token = PASTE_USER20_ACCESS_TOKEN
@studentToken = PASTE_STUDENT_ACCESS_TOKEN

@event101 = evt-101
@event102 = evt-102

# Replace these with real session IDs from your EventsService seed data.
@session101 = PASTE_SESSION_ID_UNDER_EVT101
@session102 = PASTE_SESSION_ID_UNDER_EVT102


### TEST 1: ADMIN updates evt-102
### Expected: 200 OK
PATCH {{baseUrl}}/events/{{event102}}
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "title": "Updated Student Art Exhibition"
}


### TEST 2: ORGANIZER user-10 updates own evt-101
### Expected: 200 OK
PATCH {{baseUrl}}/events/{{event101}}
Content-Type: application/json
Authorization: Bearer {{organizer10Token}}

{
  "title": "Updated Robotics Showcase"
}


### TEST 3: ORGANIZER user-10 updates evt-102 owned by user-20
### Expected: 404 Not Found
PATCH {{baseUrl}}/events/{{event102}}
Content-Type: application/json
Authorization: Bearer {{organizer10Token}}

{
  "title": "Unauthorized Update"
}


### TEST 4: STUDENT tries to update evt-101
### Expected: 403 Forbidden
PATCH {{baseUrl}}/events/{{event101}}
Content-Type: application/json
Authorization: Bearer {{studentToken}}

{
  "title": "Student Unauthorized Update"
}


### TEST 5: ORGANIZER user-10 updates a session under own evt-101
### Expected: 200 OK
PATCH {{baseUrl}}/events/{{event101}}/sessions/{{session101}}
Content-Type: application/json
Authorization: Bearer {{organizer10Token}}

{
  "title": "Updated Robotics Session"
}


### TEST 6: ORGANIZER user-10 updates a session under evt-102
### Expected: 404 Not Found
PATCH {{baseUrl}}/events/{{event102}}/sessions/{{session102}}
Content-Type: application/json
Authorization: Bearer {{organizer10Token}}

{
  "title": "Unauthorized Session Update"
}


### TEST 7: STUDENT tries to update a session
### Expected: 403 Forbidden
PATCH {{baseUrl}}/events/{{event101}}/sessions/{{session101}}
Content-Type: application/json
Authorization: Bearer {{studentToken}}

{
  "title": "Student Unauthorized Session Update"
}


### TEST 8: Update an event that does not exist
### Expected: 404 Not Found
PATCH {{baseUrl}}/events/non-existent-event
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "title": "Missing Event"
}


### TEST 9: Session belongs to another event than the URL event
### Expected: 404 Not Found
# session101 belongs to evt-101, but URL says evt-102.
PATCH {{baseUrl}}/events/{{event102}}/sessions/{{session101}}
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "title": "Wrong Parent Event Test"
}




















### Test API
GET http://localhost:3000/api/events



### Register a new customer
POST http://localhost:3000/api/auth/register
Content-Type: application/json

{
  "email": "almaz@example.et",
  "password": "Password123!"
}

### Try the same email again — expect 409
POST http://localhost:3000/api/auth/register
Content-Type: application/json

{
  "email": "almaz@example.et",
  "password": "Password123!"
}

### Invalid email — expect 400
POST http://localhost:3000/api/auth/register
Content-Type: application/json

{
  "email": "not-an-email",
  "password": "Password123!"
}

### Short password — expect 400
POST http://localhost:3000/api/auth/register
Content-Type: application/json

{
  "email": "new@example.et",
  "password": "123"
}

### Extra role field — expect 400
POST http://localhost:3000/api/auth/register
Content-Type: application/json

{
  "email": "new@example.et",
  "password": "Password123!",
  "roles": ["admin"]
}

### Login existing user
POST http://localhost:3000/api/auth/login
Content-Type: application/json

{
  "email": "almaz@example.et",
  "password": "Password123!"
}

