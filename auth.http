@baseUrl = http://localhost:3000/api

### EVENT AND SESSION IDS
@event101 = evt-101
@event102 = evt-102
@missingEvent = evt-999

@session101 = ses-201
@session102 = ses-203
@missingSession = session-999

### ==========================================
### STEP 1: LOGIN AS ADMIN
### ==========================================


# @name adminLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "admin@example.et",
  "password": "Password123!"
}

### ==========================================
### STEP 2: LOGIN AS ORGANIZER 10
### ==========================================

# @name organizer10Login
POST {{baseUrl}}/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "organizer10@example.et",
  "password": "Password123!"
}

### ==========================================
### STEP 3: LOGIN AS ORGANIZER 20
### ==========================================

# @name organizer20Login
POST {{baseUrl}}/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "organizer20@example.et",
  "password": "Password123!"
}

### ==========================================
### STEP 4: LOGIN AS STUDENT
### ==========================================

# @name studentLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "student@example.et",
  "password": "Password123!"
}


### IMPORTANT:


@adminToken =eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJ1c2VyLTEiLCJlbWFpbCI6ImFkbWluQGV4YW1wbGUuZXQiLCJyb2xlIjoiYWRtaW4iLCJpYXQiOjE3OTU2ODk1OTYsImV4cCI6MTc5NTY5MDQ5Nn0.dMlTZH0KaS2nKXSvBKYTzdp2HPvIbDOyxtnD2m1OQ6s


@organizer10Token = 


@organizer20Token = 


@studentToken =


### ==========================================
### TASK 1: EVENT AUTHORIZATION
### ==========================================

### TEST 1: ADMIN updates another organizer's event
### EXPECTED: 200 OK

PATCH {{baseUrl}}/events/{{event102}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json
Accept: application/json

{
  "title": "Admin Updated Student Art Exhibition"
}

### TEST 2: ORGANIZER 10 updates OWN event
### EXPECTED: 200 OK

PATCH {{baseUrl}}/events/{{event101}}
Authorization: Bearer {{organizer10Token}}
Content-Type: application/json
Accept: application/json

{
  "title": "Updated Robotics Showcase"
}

### TEST 3: ORGANIZER 10 updates ORGANIZER 20 event
### EXPECTED: 404 Not Found

PATCH {{baseUrl}}/events/{{event102}}
Authorization: Bearer {{organizer10Token}}
Content-Type: application/json
Accept: application/json

{
  "title": "Unauthorized Event Update"
}

### TEST 4: STUDENT tries to update an event
### EXPECTED: 403 Forbidden

PATCH {{baseUrl}}/events/{{event101}}
Authorization: Bearer {{studentToken}}
Content-Type: application/json
Accept: application/json

{
  "title": "Student Unauthorized Update"
}

### TEST 5: Update an event that does not exist
### EXPECTED: 404 Not Found

PATCH {{baseUrl}}/events/{{missingEvent}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json
Accept: application/json

{
  "title": "Missing Event"
}


### ==========================================
### TASK 2: SESSION AUTHORIZATION
### ==========================================

### TEST 6: ORGANIZER 10 updates session under OWN event
### EXPECTED: 200 OK

PATCH {{baseUrl}}/events/{{event101}}/sessions/{{session101}}
Authorization: Bearer {{organizer10Token}}
Content-Type: application/json
Accept: application/json

{
  "title": "Updated Robotics Session"
}

### TEST 7: ORGANIZER 10 updates session under OTHER event
### EXPECTED: 404 Not Found

PATCH {{baseUrl}}/events/{{event102}}/sessions/{{session102}}
Authorization: Bearer {{organizer10Token}}
Content-Type: application/json
Accept: application/json

{
  "title": "Unauthorized Session Update"
}

### TEST 8: STUDENT tries to update a session
### EXPECTED: 403 Forbidden

PATCH {{baseUrl}}/events/{{event101}}/sessions/{{session101}}
Authorization: Bearer {{studentToken}}
Content-Type: application/json
Accept: application/json

{
  "title": "Student Unauthorized Session"
}

### TEST 9: Session belongs to a different parent event
### EXPECTED: 404 Not Found

PATCH {{baseUrl}}/events/{{event101}}/sessions/{{session102}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json
Accept: application/json

{
  "title": "Wrong Parent Session"
}

### TEST 10: Session does not exist
### EXPECTED: 404 Not Found

PATCH {{baseUrl}}/events/{{event101}}/sessions/{{missingSession}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json
Accept: application/json

{
  "title": "Missing Session"
}


### ==========================================
### EXTRA TEST: INVALID TOKEN
### EXPECTED: 401 Unauthorized
### ==========================================

PATCH {{baseUrl}}/events/{{event101}}
Authorization: Bearer invalid-token
Content-Type: application/json

{
  "title": "Invalid Token Test"
}
